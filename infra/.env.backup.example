# Copy to infra/.env.backup ON THE SERVER (git-ignored) and chmod 600 it.
# backup.sh REFUSES to run (and alerts) if the file is readable by group or others.
# Never commit real values.
BACKUP_ENV=<staging-or-live>
# Absolute docroot of this environment (wp-config.php lives one level above it).
DOCROOT=<absolute-path-to-docroot>
S3_BUCKET=<existing-bucket-name>
S3_PREFIX=blog-backups
AWS_REGION=ap-south-1
# Write-only IAM user for THIS environment only (s3:PutObject on <bucket>/blog-backups/<env>/*).
# One user per environment; see infra/restore.md.
AWS_ACCESS_KEY_ID=<write-only-access-key-id>
AWS_SECRET_ACCESS_KEY=<write-only-secret>
# Address notified on failure. If left empty, backup.sh falls back to $ALERT_EMAIL from the
# environment, then to the cPanel contact address in ~/.contactemail (cPanel keeps it there).
# The same fallback is used when THIS file is missing or unreadable.
ALERT_EMAIL=
# Directory holding the PHP 8.3 php (cron has a minimal PATH). Required when the default php is below 8.3.
REMOTE_PATH_PREFIX=
# Optional. WP-CLI command, e.g. '<php83-bin> <wp-path>' (default: wp).
WP_BIN=
# Optional overrides: S3_ENDPOINT (S3-compatible endpoint, implies path style), S3_PATH_STYLE=1,
# PYTHON_BIN, BACKUP_LOG (default ~/logs/mf-backup.log), BACKUP_LOCK, TMPDIR.
