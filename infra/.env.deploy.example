# Copy to infra/.env.deploy (git-ignored) and fill in. Never commit real values.
DEPLOY_HOST=<server-hostname>
DEPLOY_USER=<ssh-username>
DEPLOY_PORT=22
# Absolute docroots on the server (wp-config.php lives one level above the docroot).
STAGING_ROOT=<absolute-path-to-staging-docroot>
LIVE_ROOT=<absolute-path-to-live-docroot>
STAGING_URL=https://<staging-host>
LIVE_URL=https://<live-host>
# Optional: path to an executable that prints the SSH password (used via SSH_ASKPASS).
SSH_ASKPASS_SCRIPT=
# REQUIRED when the server's default php is below 8.3: the directory holding the PHP 8.3 php,
# prepended to PATH for the version gate, php -l, composer and wp. Without it the deploy stops at the gate.
REMOTE_PATH_PREFIX=
# Optional overrides (defaults: wp, composer).
WP_BIN=
COMPOSER_BIN=
# Host key policy: yes (default; pin the key first, see provision.md), accept-new, ask or no.
SSH_STRICT_HOST_KEY_CHECKING=yes
