# Copy to .env (git-ignored) and fill in. Placeholders only - never commit real values.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Extra wp-config.php PHP, one statement per line (use \n inside the quoted value).
WORDPRESS_CONFIG_EXTRA="define('DISALLOW_FILE_EDIT', true);\ndefine('WP_ENVIRONMENT_TYPE', 'local');"
