{
    "name": "codespark/moneyfrog-blog",
    "description": "Moneyfrog Insights blog: must-use plugin, theme and tooling",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        { "type": "composer", "url": "https://wpackagist.org", "only": ["wpackagist-plugin/*", "wpackagist-theme/*"] }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "wpackagist-plugin/two-factor": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "allow-plugins": { "composer/installers": true },
        "sort-packages": true
    },
    "extra": {
        "installer-paths": {
            "wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
            "wp-content/themes/{$name}/": ["type:wordpress-theme"]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
